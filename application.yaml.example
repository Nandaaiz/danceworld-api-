spring:
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:5432/forrodb}
    username: ${DB_USERNAME:your_username}
    password: ${DB_PASSWORD:your_password}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: validate
    show-sql: true
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
    open-in-view: false
  flyway:
    enabled: true
    locations: classpath:db/migration
  security:
    user:
      name: disabled
      password: disabled

server:
  port: 8080